          }
        }
      }
    },
    "Whisper is being set up for this phone. The first time takes a few minutes, later runs are quick. The ring is a guide from the last time, not a measurement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper is being set up for this phone. The first time takes a few minutes, later runs are quick. The ring is a guide from the last time, not a measurement."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper bu telefon için hazırlanıyor. İlk seferde birkaç dakika sürer, sonrakiler hızlıdır. Halka, geçen seferin süresine göre bir tahmindir, ölçüm değildir."
          }
        }
      }
    },
    "Whisper turns the speech into text. The ring follows how much of the recording it has read." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper turns the speech into text. The ring follows how much of the recording it has read."
